# rnsd config for the C6L WiFi-TCP bridge (BRIDGE_PLAN).
#
# The port below is the C6L's DHCP address on your LAN — the console
# prints it after association. Update it if the lease changes (or pin a
# static lease in your router).
#
# NOTE on the port URI: this MUST stay an RNodeInterface with a tcp://
# port URI, NOT a TCPClientInterface (the C6L is the RNode itself, not a
# transport hop). RNS's RNodeInterface treats the WHOLE string after
# tcp:// as a hostname — it does NOT parse a :port suffix and connects
# to TCPConnection.TARGET_PORT = 7633 (RNS 1.5.4, RNodeInterface.py).
# So the URI must carry NO port, and the bridge listens on 7633.
# (Bench-verified: tcp://ip:4990 -> getaddrinfo "Name or service not
# known"; the plan's original 4990 was unreachable by stock rnsd.)

[reticulum]
enable_transport = False
instance_name = c6l_tcp

[interfaces]

  [[C6L-TCP]]
    type = RNodeInterface
    enabled = yes
    port = tcp://192.168.1.233
    frequency = 867500000
    bandwidth = 125000
    txpower = 14
    spreadingfactor = 9
    codingrate = 5
